ext_color":""}},"roller_trust":{"type":"roller-trust-strip","settings":{}},"roller_overview":{"type":"roller-overview","settings":{"eyebrow":"MINIMAL BY DESIGN","heading":"A Cleaner Way to Cover the Window.","show_product_description":true}},"roller_light":{"type":"roller-light-control","settings":{"eyebrow":"LIGHT CONTROL","heading":"Choose the Fabric Around the Room."}},"roller_roll":{"type":"roller-roll-direction","settings":{"eyebrow":"ROLL DIRECTION","heading":"Standard Roll or Reverse Roll?"}},"roller_edge":{"type":"roller-edge-detail","settings":{"eyebrow":"EDGE & BOTTOM DETAIL","heading":"A Small Clearance Keeps the Shade Moving Freely."}},"roller_mount":{"type":"roller-mount-guide","settings":{"eyebrow":"MOUNT TYPE","heading":"Inside or Outside Mount?"}},"roller_measure":{"type":"roller-measurement","settings":{"eyebrow":"MEASURE FOR YOUR WINDOW","heading":"Width. Height. Depth.","guide_link":"shopify://pages/measurement-finder"}},"roller_depth":{"type":"roller-depth-roll","settings":{"eyebrow":"WINDOW DEPTH & ROLL","heading":"Check the Space Above and Around the Glass."}},"roller_controls":{"type":"roller-control-options","settings":{"eyebrow":"CONTROL OPTIONS","heading":"Choose the Way You Use the Shade."}},"roller_apps":{"type":"roller-applications","settings":{"eyebrow":"ROOM APPLICATIONS","heading":"Quiet Geometry for Different Rooms."}},"roller_install":{"type":"roller-installation","settings":{"eyebrow":"INSTALLATION","heading":"Set the Brackets. Attach the Shade. Test the Roll.","guide_link":"shopify://pages/measurement-finder"}},"roller_care":{"type":"roller-care","settings":{"eyebrow":"CARE","heading":"Keep the Fabric and Mechanism Clean."}},"roller_faq":{"type":"roller-faq","settings":{"eyebrow":"ROLLER SHADE FAQ","heading":"Before You Measure and Order."},"blocks":{"faq_1":{"type":"faq","settings":{"question":"What are roller shades?","answer":"<p>Roller shades use a single fabric panel that rolls around a tube at the top of the window for a clean, compact profile.</p>"}},"faq_2":{"type":"faq","settings":{"question":"What is the difference between light filtering and blackout roller shades?","answer":"<p>Light-filtering fabrics soften daylight while blackout fabrics are designed for stronger light reduction through the main fabric surface.</p>"}},"faq_3":{"type":"faq","settings":{"question":"Will a blackout roller shade make the room completely dark?","answer":"<p>Blackout fabric can strongly reduce light through the shade, but final room darkness also depends on mounting method, edge gaps and the window itself.</p>"}},"faq_4":{"type":"faq","settings":{"question":"Should I choose inside or outside mount?","answer":"<p>Inside mount creates a more integrated look when enough recess depth is available. Outside mount can provide broader coverage around the opening.</p>"}},"faq_5":{"type":"faq","settings":{"question":"Why can roller shades have side gaps?","answer":"<p>The fabric needs operating clearance from the hardware and frame. The visible gap varies by system, mount and window conditions.</p>"}},"faq_6":{"type":"faq","settings":{"question":"How much mounting depth do I need?","answer":"<p>Depth requirements vary by roller system, finished size and hardware. Follow the current product configurator and measurement guide for the exact requirement.</p>"}},"faq_7":{"type":"faq","settings":{"question":"What is standard roll versus reverse roll?","answer":"<p>Standard roll places the fabric closer to the window. Reverse roll lets the fabric fall from the front of the tube and can help with certain handles or trim conditions.</p>"}},"faq_8":{"type":"faq","settings":{"question":"Can roller shades be motorized?","answer":"<p>Motorization is available on supported configurations. Check the live product options above for the current control systems and size limits.</p>"}},"faq_9":{"type":"faq","settings":{"question":"How do I measure for roller shades?","answer":"<p>Measure width, height and available mounting depth. Use the measurement guide and follow the product configurator for any production allowance or deduction.</p>"}},"faq_10":{"type":"faq","settings":{"question":"How should I clean roller shades?","answer":"<p>Use light dusting and material-appropriate spot cleaning. Avoid saturating the fabric or mechanism, and follow the care guidance for the selected material.</p>"}}},"block_order":["faq_1","faq_2","faq_3","faq_4","faq_5","faq_6","faq_7","faq_8","faq_9","faq_10"]},"roller_cta":{"type":"roller-final-cta","settings":{"eyebrow":"CUSTOM ROLLER SHADES","heading":"Build the Shade Around the Window.","body":"<p>Choose the fabric, mount and control system, then enter the dimensions for your window.</p>","primary_label":"Back to Product","primary_link":"#MainContent","secondary_label":"Measurement Guide","secondary_link":"shopify://pages/measurement-finder"}},"related-products":{"type":"related-products","settings":{"recommendations_count":8,"products":[],"full_width":true,"stack_products":false,"show_progress_bar":false,"products_per_row_mobile":"2","products_per_row_desktop":4,"subheading":"FIND THE RIGHT SYSTEM","title":"Compare Window Treatments","content":"<p>Compare roller shades with other made-to-measure window treatments for light control, privacy and room use.</p>","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","product_card_background":"","product_card_text_color":""}}},"order":["main","roller_trust","roller_overview","roller_light","roller_roll","roller_edge","roller_mount","roller_measure","roller_depth","roller_controls","roller_apps","roller_install","roller_care","roller_faq","roller_cta","related-products"]}